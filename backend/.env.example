# Environment variables the app reads. It does not load a .env file itself: export these in
# your shell or set them in your hosting dashboard. Locally only DJANGO_DEBUG=1 is needed.

DJANGO_DEBUG=1
# Required when DJANGO_DEBUG is off:
# DJANGO_SECRET_KEY=change-me-to-a-long-random-string
# DJANGO_ALLOWED_HOSTS=example.com

# Optional overrides
# OSRM_URL=https://router.project-osrm.org
# OPEN_METEO_URL=https://api.open-meteo.com/v1/forecast
# OPEN_METEO_API_KEY=            # paid key: lifts the free-tier rate limit
# SECURE_SSL_REDIRECT=1
# LOG_LEVEL=INFO
